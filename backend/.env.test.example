NODE_ENV=test

# Database yang dipakai test. Diisi nilai DATABASE_URL dari backend/.env.
TEST_DATABASE_URL="postgresql://..."
# Test menulis dan menghapus data pada database yang sama dengan aplikasi.
ALLOW_SHARED_DB_TESTS=1

# Cloudflare R2 (boleh bucket yang sama dengan aplikasi).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Mailpit lokal: SMTP port 1025, API/UI port 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
MAIL_FROM="ARKANA Test <no-reply@e2e.arkana.test>"
MAILPIT_URL=http://localhost:8025

# Rahasia JWT khusus test (minimal 32 karakter).
JWT_ACCESS_SECRET=
