generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
}

enum WorkCategory {
  PELAKSANAAN_TUGAS
  PENGEMBANGAN_PERBAIKAN
  KOORDINASI_RAPAT
  PELAYANAN_PENDAMPINGAN
  ADMINISTRASI_PELAPORAN
  PENGEMBANGAN_KOMPETENSI
  PERJALANAN_DINAS
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  role         Role       @default(USER)
  status       UserStatus @default(INVITED)
  activatedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  accountTokens AccountToken[]
  workLogs      WorkLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AccountToken {
  id        String           @id @default(uuid())
  tokenHash String           @unique
  type      AccountTokenType
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model WorkLog {
  id           String       @id @default(uuid())
  publicToken  String       @unique @default(dbgenerated("gen_random_uuid()"))
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate DateTime     @db.Date
  name         String
  description  String
  output       String
  category     WorkCategory
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  files WorkLogFile[]

  @@index([userId, activityDate])
}

model WorkLogFile {
  id           String   @id @default(uuid())
  workLogId    String
  workLog      WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  key          String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([workLogId])
}
