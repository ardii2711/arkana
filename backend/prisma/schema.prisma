generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
}

enum WorkCategory {
  PELAKSANAAN_TUGAS
  PENGEMBANGAN_PERBAIKAN
  KOORDINASI_RAPAT
  PELAYANAN_PENDAMPINGAN
  ADMINISTRASI_PELAPORAN
  PENGEMBANGAN_KOMPETENSI
  PERJALANAN_DINAS
}

enum ScheduleCategory {
  RAPAT_KOORDINASI
  PEKERJAAN_TUGAS
  PELATIHAN_PENGEMBANGAN
  PERJALANAN_DINAS
  KEGIATAN_PRIBADI
  TENGGAT_WAKTU
  LAINNYA
}

enum ScheduleStatus {
  NOT_STARTED
  DONE
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  role         Role       @default(USER)
  status       UserStatus @default(INVITED)
  activatedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  accountTokens  AccountToken[]
  workLogs       WorkLog[]
  schedules      Schedule[]
  archiveFolders ArchiveFolder[]
  archiveFiles   ArchiveFile[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AccountToken {
  id        String           @id @default(uuid())
  tokenHash String           @unique
  type      AccountTokenType
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model WorkLog {
  id           String       @id @default(uuid())
  publicToken  String       @unique @default(dbgenerated("gen_random_uuid()"))
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate DateTime     @db.Date
  name         String
  description  String
  output       String
  category     WorkCategory
  target       String?
  realisasi    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  files WorkLogFile[]

  @@index([userId, activityDate])
}

model WorkLogFile {
  id           String   @id @default(uuid())
  workLogId    String
  workLog      WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  key          String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([workLogId])
}

model Schedule {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean          @default(false)
  location    String?
  category    ScheduleCategory
  status      ScheduleStatus   @default(NOT_STARTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, startAt])
}

model ArchiveFolder {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    ArchiveFolder?  @relation("ArchiveFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  ArchiveFolder[] @relation("ArchiveFolderChildren")
  files     ArchiveFile[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, parentId, name])
  @@index([userId, parentId])
}

model ArchiveFile {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       ArchiveFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  documentDate DateTime?      @db.Date
  key          String         @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, folderId])
}
