NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Basis URL frontend untuk tautan bukti dukung pada laporan (default: CORS_ORIGIN)
# PUBLIC_WEB_URL=https://arkana.example.com
LOG_LEVEL=info

# Runtime: Supabase transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Prisma CLI migrations: Supabase session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Seeding akun Admin awal (hanya dibutuhkan saat `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ARKANA <no-reply@example.com>"

# JWT access token (minimal 32 karakter)
JWT_ACCESS_SECRET=

# Google OAuth (opsional; login Google membalas 503 bila tidak diisi)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
