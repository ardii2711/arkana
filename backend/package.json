{
  "name": "@arkana/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "check:file-rules": "tsx scripts/check-work-log-file-rules.ts",
    "check:archive-folders": "tsx scripts/check-archive-folders.ts",
    "check:report-format": "tsx scripts/check-report-format.ts",
    "check:schedule-rules": "tsx scripts/check-schedule-rules.ts",
    "check:dashboard": "tsx scripts/check-dashboard.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-storage": "3.1169.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "google-auth-library": "^11.3.4",
    "heic-convert": "2.1.0",
    "helmet": "^8.3.0",
    "jose": "6.2.17",
    "nodemailer": "10.5.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/busboy": "1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/heic-convert": "2.1.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "8.23.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all",
    "endOfLine": "lf"
  }
}
